# ---------------------------------------------------------------------------
# environments/dev/.env.example — MODELO do arquivo de ambiente "dev".
#
# No servidor este arquivo vira /opt/gini/dev/.env, criado À MÃO:
#
#   sudo install -o gha-runner -g gha-runner -m 600 /dev/null /opt/gini/dev/.env
#   sudo -u gha-runner nano /opt/gini/dev/.env
#
# Regras:
#   - modo 600, dono gha-runner (o deploy.sh valida e aborta se divergir);
#   - NUNCA versionar o .env real, apenas este .example;
#   - todo valor CHANGE_ME precisa ser substituído.
#
# Descrição campo a campo: docs/variaveis-e-secrets.md
# ---------------------------------------------------------------------------

# Nome do ambiente. Usado nos nomes de container e nas labels. Precisa casar
# com o diretório e com o projeto Compose (-p gini-dev).
ENV_NAME=dev

# Imagens no ghcr.io, sem a tag (a tag vem de images.env). Sempre minúsculas.
# Devem ser iguais às Variables FRONTEND_IMAGE / BACKEND_IMAGE do repositório.
FRONTEND_IMAGE=ghcr.io/pi-ams-2025-2026/frontend-nextjs
BACKEND_IMAGE=ghcr.io/pi-ams-2025-2026/backend-java

# Portas publicadas NO HOST. As portas internas são fixas (3000 / 8080).
# Precisam estar liberadas no UFW (scripts/bootstrap-server.sh).
FRONTEND_PORT=3001
BACKEND_PORT=8081

# Banco de dados (container `db`, sem porta publicada no host).
POSTGRES_DB=gini_dev
POSTGRES_USER=gini_dev
# Gere com: openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_ME

# Segredo de assinatura dos JWT do backend. Diferente em cada ambiente.
# Gere com: openssl rand -base64 48
JWT_SECRET=CHANGE_ME

# Origens aceitas pelo CORS do backend. Lista separada por vírgula, sem espaços.
# Em dev, inclua também o host de acesso pela rede local, se houver.
CORS_ALLOWED_ORIGINS=CHANGE_ME

# Retenção dos dumps em /opt/gini/backups/dev (dias). Usada por backup-db.sh.
BACKUP_RETENTION_DAYS=7
