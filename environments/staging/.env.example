# ---------------------------------------------------------------------------
# environments/staging/.env.example — MODELO do arquivo de ambiente "staging".
#
# No servidor este arquivo vira /opt/gini/staging/.env, criado À MÃO:
#
#   sudo install -o gha-runner -g gha-runner -m 600 /dev/null /opt/gini/staging/.env
#   sudo -u gha-runner nano /opt/gini/staging/.env
#
# Regras:
#   - modo 600, dono gha-runner (o deploy.sh valida e aborta se divergir);
#   - NUNCA versionar o .env real, apenas este .example;
#   - todo valor CHANGE_ME precisa ser substituído.
#
# Descrição campo a campo: docs/variaveis-e-secrets.md
# ---------------------------------------------------------------------------

# Nome do ambiente. Usado nos nomes de container e nas labels. Precisa casar
# com o diretório e com o projeto Compose (-p gini-staging).
ENV_NAME=staging

# Imagens no ghcr.io, sem a tag (a tag vem de images.env). Sempre minúsculas.
# Devem ser iguais às Variables FRONTEND_IMAGE / BACKEND_IMAGE do repositório.
FRONTEND_IMAGE=ghcr.io/pi-ams-2025-2026/frontend-nextjs
BACKEND_IMAGE=ghcr.io/pi-ams-2025-2026/backend-java

# Portas publicadas NO HOST. As portas internas são fixas (3000 / 8080).
# Precisam estar liberadas no UFW (scripts/bootstrap-server.sh).
FRONTEND_PORT=3002
BACKEND_PORT=8082

# Banco de dados (container `db`, sem porta publicada no host).
POSTGRES_DB=gini_staging
POSTGRES_USER=gini_staging
# Gere com: openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_ME

# Segredo de assinatura dos JWT do backend. Diferente em cada ambiente.
# Gere com: openssl rand -base64 48
JWT_SECRET=CHANGE_ME

# URL pública do frontend deste ambiente: esquema + host + porta, SEM barra
# final e SEM caminho. Aponte para a URL de homologação do frontend.
# O backend usa este valor em dois lugares: como origem permitida no CORS e
# como base do link do e-mail de recuperação de senha. Aceita UMA única origem.
# Exemplo: http://192.168.0.10:3002
FRONTEND_URL=CHANGE_ME

# SMTP do e-mail de recuperação de senha. O backend (perfil prod) exige HOST,
# USERNAME, PASSWORD e FROM; sem eles não sobe. Este repositório não provê
# servidor SMTP: use um serviço externo.
SMTP_HOST=CHANGE_ME
# Padrões do backend: 587 / true / true. Ajuste conforme o provedor.
SMTP_PORT=587
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_USERNAME=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
# Remetente dos e-mails (precisa ser aceito pelo provedor SMTP).
SMTP_FROM=CHANGE_ME

# Opcionais (descomente para alterar o padrão do backend):
# PASSWORD_RESET_EXPIRATION_MINUTES=15

# Retenção dos dumps em /opt/gini/backups/staging (dias). Usada por backup-db.sh.
BACKUP_RETENTION_DAYS=7
