# ---------------------------------------------------------------------------
# environments/staging/images.env.example — MODELO de /opt/gini/staging/images.env
#
# Este arquivo guarda APENAS as tags das imagens e é REESCRITO pelo
# scripts/deploy.sh a cada deploy (o anterior é salvo em images.env.previous
# para permitir rollback). Não coloque mais nada aqui.
#
# Tags padrão do PRIMEIRO deploy (quando ainda não existe images.env):
#   dev -> dev | staging -> staging | production -> main
#
# Em deploys normais o valor é uma tag imutável, por exemplo:
#   FRONTEND_TAG=sha-a1b2c3d-staging   (frontend: sufixo do ambiente)
#   BACKEND_TAG=sha-a1b2c3d
# ---------------------------------------------------------------------------
FRONTEND_TAG=staging
BACKEND_TAG=staging
