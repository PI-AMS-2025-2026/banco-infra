# ---------------------------------------------------------------------------
# aws/.env.aws.example — MODELO do /opt/gini/aws/.env de cada instância EC2.
#
# Normalmente você NÃO edita este arquivo: o aws/bootstrap-ec2.sh gera o
# /opt/gini/aws/.env (modo 600) a partir das variáveis do user data. Este
# modelo existe para:
#   - validar o compose localmente:
#       docker compose --env-file aws/.env.aws.example -f aws/docker-compose.aws.yml config
#   - documentar o que o script grava e servir de base para ajuste manual.
#
# Regras: NUNCA versionar o .env real; todo CHANGE_ME precisa ser substituído.
# Descrição campo a campo: aws/PARAMETERS.md
# ---------------------------------------------------------------------------

# Imagens públicas no ghcr.io (sem tag) e tags imutáveis.
# FRONTEND_TAG precisa ser uma imagem ÚNICA (sha-<7>, rótulo
# br.fatec.gini.runtime-api-url=true); tags sha-<7>-<ambiente> não servem.
BACKEND_IMAGE=ghcr.io/pi-ams-2025-2026/backend-java
BACKEND_TAG=sha-0000000
FRONTEND_IMAGE=ghcr.io/pi-ams-2025-2026/frontend-nextjs
FRONTEND_TAG=sha-0000000

# Ambiente lógico do backend (emissor dos JWT). Na AWS: homologação.
APP_ENVIRONMENT=staging

# Banco: Amazon RDS. Endpoint SEM porta (a porta é sempre 5432).
# Exemplo fictício: gini-db.abcdefghijkl.us-east-1.rds.amazonaws.com
RDS_ENDPOINT=CHANGE_ME.us-east-1.rds.amazonaws.com
DB_NAME=gini
DB_USER=gini_admin
# Gerada UMA vez pelo aluno: openssl rand -hex 32
DB_PASSWORD=CHANGE_ME

# Igual nas duas instâncias. Gerado UMA vez: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_CHANGE_ME_CHANGE_ME_CHANGE_ME

# Derivadas do DNS do ALB (minúsculas, sem barra final).
# Exemplo fictício: gini-lb-1234567890.us-east-1.elb.amazonaws.com
FRONTEND_URL=http://CHANGE_ME.us-east-1.elb.amazonaws.com
API_URL=http://CHANGE_ME.us-east-1.elb.amazonaws.com:8080

# E-mail de recuperação de senha → Mailpit da própria instância.
# O bootstrap grava COMPOSE_PROFILES=mailpit quando ENABLE_MAILPIT=true.
# Aqui fica comentado para o `config` sem --profile validar o caso sem Mailpit.
# COMPOSE_PROFILES=mailpit
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_AUTH=false
SMTP_STARTTLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@gini.local
